# Copy this file to .env and fill it in. (.env is git-ignored: never commit it.)

# Neon connection string: Neon dashboard -> your project -> Connect -> copy the connection string.
# Use the "Pooled connection" one (the host contains "-pooler"). It must end with ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Long random value used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# First admin account (created on first start if no admin exists). Change the password!
ADMIN_EMAIL=admin@linkpulse.test
ADMIN_PASSWORD=admin1234

# Public address of the site, e.g. https://linkpulse.onrender.com (used in short URLs and QR codes)
BASE_URL=

# 1 = fill an empty database with demo data on first start
SEED_DEMO=0

# Optional: Gemini key for written insights and smarter Ask AI
GEMINI_API_KEY=
