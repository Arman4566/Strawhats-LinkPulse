{
  "name": "linkpulse",
  "version": "1.1.0",
  "description": "LinkPulse: URL shortener and analytics platform (Team Strawhats)",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env server/seed.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "dev:client": "npm --prefix client run dev"
  },
  "dependencies": {
    "pg": "^8.13.0"
  }
}
