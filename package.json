{
  "name": "linkpulse",
  "version": "1.0.0",
  "description": "LinkPulse: URL shortener and analytics platform (Team Strawhats)",
  "private": true,
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "dev:client": "npm --prefix client run dev"
  }
}